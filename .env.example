# ============================================================================
# ALPHA SHIELD v3.2 — 환경변수 예시
#   cp .env.example .env  후 값을 채우세요. .env 는 .gitignore 로 커밋되지 않습니다.
# ============================================================================

# 실행 모드: dry-run | paper | live   (기본값 dry-run — 주문을 전혀 보내지 않습니다)
ALPHA_MODE=dry-run

# 데이터 디렉터리 (SQLite, 토큰, 상태 파일). 기본 ./state
ALPHA_DATA_DIR=state

# 로그 레벨: DEBUG | INFO | WARNING | ERROR
ALPHA_LOG_LEVEL=INFO

# ----------------------------------------------------------------------------
# 실주문 이중 잠금 — 두 조건이 모두 있어야만 실주문이 나갑니다.
#   1) 아래 LIVE_ORDERS=true
#   2) state/ARMED 파일 존재 (touch state/ARMED)
# 둘 중 하나라도 없으면 live 모드 기동이 거부됩니다.
# ----------------------------------------------------------------------------
LIVE_ORDERS=false

# ----------------------------------------------------------------------------
# 토스증권 Open API (WTS > 설정 > Open API 에서 발급)
#   - 허용 IP 등록이 안 되어 있으면 모든 호출이 403(ip-not-allowed) 입니다.
#   - 토큰은 클라이언트당 1개만 유효합니다. 이 프로그램은 state/toss_token.json
#     파일을 공유하고 파일 락으로 발급을 직렬화합니다. 여러 프로세스를 띄우지 마세요.
# ----------------------------------------------------------------------------
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# 계좌 식별 번호(accountSeq). 비워 두면 기동 시 GET /api/v1/accounts 로 1회 조회합니다.
TOSS_ACCOUNT_SEQ=
TOSS_BASE_URL=https://openapi.tossinvest.com

# ----------------------------------------------------------------------------
# 외부 데이터 (읽기 전용, 키 불필요)
# SEC EDGAR 는 User-Agent 에 연락처를 요구합니다.
# ----------------------------------------------------------------------------
SEC_USER_AGENT=alpha-shield/3.2 (you@example.com)

# 알림 웹훅(선택). 비워 두면 logs/alerts.jsonl 에만 기록합니다.
ALERT_WEBHOOK_URL=

# 페이퍼 모드 시작 자금(USD). 실계좌 규모와 맞춰 두세요.
PAPER_STARTING_CASH=380.00
